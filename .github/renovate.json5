{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The portfolio's shared configuration, extended by name: the timezone, the Monday schedule, the
  // limits, `platformAutomerge: false`, the kotlin/kotlinx/sborka/ci-actions groups and majors going
  // to a human were identical in ten repositories and now live in sborka.
  //
  // The automerge preset is extended second on purpose — its rule has to land after the base
  // preset's "majors get a human" to override it for the harness — and its precondition holds
  // here: build.yaml runs on `pull_request`.
  extends: [
    "github>youndie/sborka",
    "github>youndie/sborka:automerge-harness",
  ],

  // REPEATED IN FULL, not added to: `ignorePaths` is replaced by this value rather than merged with
  // the preset's, so dropping the first two would un-ignore them.
  ignorePaths: ["**/build/**", "**/.gradle/**", "**/kotlin-js-store/**"],

  // Below the extends, so these win: package rules are concatenated, preset first, and the last
  // match takes effect.
  packageRules: [
    {
      // BROADER THAN THE PRESET, which refuses `-0.6.x-compat` by name. A `-compat` build is the
      // new version compiled against an OLD API; it sorts as newer and is never an upgrade,
      // whichever line it is published for. Kept so the next such line is refused too.
      description: "kotlinx-datetime publishes `-compat` builds for consumers pinned to an older line. They sort as newer and are not upgrades",
      matchPackageNames: ["org.jetbrains.kotlinx:kotlinx-datetime"],
      allowedVersions: "!/-compat$/",
    },
    {
      description: "cryptography-kotlin: core, random and the providers ship as one version",
      matchPackageNames: ["/^dev\\.whyoleg\\.cryptography[:.]/"],
      groupName: "cryptography-kotlin",
    },
    {
      description: "Koin — one BOM, one version",
      matchPackageNames: ["/^io\\.insert-koin[:.]/"],
      groupName: "koin",
    },
    {
      description: "ktlint is build tooling, not a runtime dependency",
      matchPackageNames: [
        // The Gradle plugin is named by its id, with nothing after it — a pattern that demands a
        // `:` or a `.` next matches the coordinate and misses the plugin entirely.
        "org.jlleitschuh.gradle.ktlint",
        "/^com\\.pinterest\\.ktlint[:.]/",
      ],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      // The runtime image is distroless and the libraries are copied out of a Debian stage that has
      // to match it — changing either one is a decision about a pair, not a bump of one line. No
      // check on a pull request builds this file, so nothing here has run when the PR looks green.
      description: "Base images: the build stage and the runtime stage are a pair",
      matchManagers: ["dockerfile"],
      automerge: false,
      // Own branch, so an image never shares a pull request with something that may automerge —
      // one dependency that may not holds back the whole PR.
      additionalBranchPrefix: "docker-",
    },
    {
      description: "The local stand is pinned deliberately: a new tag is a decision, not a bump",
      matchManagers: ["docker-compose"],
      automerge: false,
      additionalBranchPrefix: "stand-",
      labels: ["dependencies", "test server"],
    },
    {
      // `image.tag` is empty on purpose — it means the chart's appVersion, which the release
      // process writes. Renovate filling it in would pin the chart to whatever tag existed the
      // morning it ran. Third-party images in this file (postgres) stay tracked.
      description: "The chart names its own image; that version is not a dependency",
      matchManagers: ["helm-values"],
      matchPackageNames: ["/^ghcr\\.io\\/youndie\\//"],
      enabled: false,
    },
  ],
}
